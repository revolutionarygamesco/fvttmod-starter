{
  "name": "@revolutionarygamesco/fvttmod-starter",
  "description": "A starting point for Foundry VTT modules.",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "pack": "node ./scripts/pack.js",
    "complete-table": "node ./scripts/complete-table.js",
    "test": "vitest run --typecheck && npm run typecheck",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@foundryvtt/foundryvtt-cli": "^3.0.2",
    "@jest/globals": "^30.1.2",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^4.1.10",
    "sass": "^1.93.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.6",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@revolutionarygamesco/common": "^1.2.6",
    "@revolutionarygamesco/common-foundryvtt": "^0.3.14"
  }
}
